# Production uses Supabase. `local` remains available only for isolated UI development.
VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ORIGIN=http://127.0.0.1:5173
VITE_MAX_UPLOAD_MB=50

# Worker / edge-function secrets: set them only in Supabase or the worker service, never here.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# OPENAI_API_KEY=
# AI_MODEL=gpt-5.5
# POLL_SECONDS=5
# LEASE_SECONDS=300
# WORKER_WAKE_URL=https://TU-WORKER.onrender.com/internal/wake
# WORKER_WAKE_TOKEN=compartido-solo-entre-supabase-y-el-worker
