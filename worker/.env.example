# Configuración del Worker para Territorium (FastAPI + Extracción IA)
# =========================================================================

# 1. Credenciales de Supabase (Obtenlas en Project Settings > API en tu panel de Supabase)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=TU_SERVICE_ROLE_KEY_AQUI

# 2. Configuración de IA (Google Gemini API con compatibilidad OpenAI)
# Pega tu clave de Google AI Studio en GEMINI_API_KEY o OPENAI_API_KEY
GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY_DE_GEMINI
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.0-flash

# 3. Control de Tareas y Polling
WORKER_ENABLED=true
EXPEDIENTE_V2_WORKER_ENABLED=true
POLL_SECONDS=5
EXPEDIENTE_V2_POLL_SECONDS=2
LEASE_SECONDS=300
